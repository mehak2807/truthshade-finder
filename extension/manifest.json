{
  "manifest_version": 3,
  "name": "TruthShade AI Verifier",
  "description": "Verify suspicious text or screenshots with AI from anywhere on the web.",
  "version": "1.0.0",
  "action": {
    "default_title": "TruthShade AI Verifier",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "https://*/api/fact-check"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
