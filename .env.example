# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Gemini API Configuration (for AI-powered misinformation detection)
# Get your key from: https://aistudio.google.com/app/apikeys
VITE_GEMINI_API_KEY=your_gemini_api_key

# Optional: Add your own API keys
VITE_API_KEY=your_api_key
# IMPORTANT: Lovable API Key (required for fact-check functions)
# Get this from https://dashboard.lovable.dev or contact admin
# Set this as a secret in Supabase: supabase secrets set LOVABLE_API_KEY <your_key>
LOVABLE_API_KEY=your_lovable_api_key
